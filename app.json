{
  "expo": {
    "name": "Worketa Employee",
    "slug": "worketa-employee",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/worketa-employee-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "worketa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worketa.employee",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.worketa.employee",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/worketa-employee-logo.png",
        "monochromeImage": "./assets/worketa-employee-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/worketa-employee-logo.png",
          "backgroundColor": "#F6F8FB",
          "imageWidth": 220
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2052cfea-d1b6-4194-87bd-e93040039829"
      }
    }
  }
}
